{
  "name": "decibel-windows",
  "version": "1.0.1",
  "description": "Decibel for Windows. Shares its music folder with the iPhone app.",
  "main": "src/main.js",
  "author": "Anurag Mallick",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.anuragmallick.decibel",
    "productName": "Decibel",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Decibel-Setup-${version}.exe"
    }
  }
}
